function loadQ(){
  answered=false;
  const q=QS[order[qi]];
  const opts=shuffle(q.o.map((t,i)=>({t,ok:i===q.a})));
  document.getElementById('qNo').textContent=`Soal ${qi+1}/${QS.length}`;
  document.getElementById('qTurn').textContent='Giliran: '+G[gi].n;
  document.getElementById('qText').textContent=q.q;
  document.getElementById('qFb').innerHTML='';
  document.getElementById('qSteal').innerHTML='';
  document.getElementById('qNext').style.display='none';
  const ob=document.getElementById('qOpts');
  ob.innerHTML=opts.map((o,i)=>`<button class="opt" data-ok="${o.ok}">${String.fromCharCode(65+i)}. ${o.t}</button>`).join('');
  ob.querySelectorAll('.opt').forEach(b=>b.onclick=()=>answer(b.dataset.ok==='true',b));
  drawScore();
  tl=30;tick();clearInterval(timer);
  timer=setInterval(()=>{tl--;tick();if(tl<=0){clearInterval(timer);if(!answered)answer(false,null,true)}},1000);
}
function tick(){document.getElementById('qTime').textContent='⏱ '+tl;document.getElementById('qBar').style.width=(tl/30*100)+'%'}
function reveal(){document.querySelectorAll('#qOpts .opt').forEach(x=>{x.disabled=true;if(x.dataset.ok==='true')x.classList.add('right')})}
function answer(ok,btn,timeout){
  if(answered)return;answered=true;clearInterval(timer);
  const q=QS[order[qi]];reveal();
  if(ok){
    const pts=10+(tl>=20?5:0);G[gi].s+=pts;
    document.getElementById('qFb').innerHTML=`<div class="ok">✅ Benar! +${pts} poin untuk ${G[gi].n}. ${q.e}</div>`;
  }else{
    if(btn)btn.classList.add('wrong');
    document.getElementById('qFb').innerHTML=`<div class="think">${timeout?'⏰ Waktu habis. ':'❌ Belum tepat. '}Kelompok lain boleh merebut (+5)! Penjelasan: ${q.e}</div>`;
    document.getElementById('qSteal').innerHTML='<b>Siapa yang berhasil merebut?</b> '+G.map((g,i)=>i===gi?'':`<button class="btn" style="background:${g.c}" onclick="steal(${i})">${g.n}</button>`).join('')+'<button class="btn ghost" onclick="steal(-1)">Tidak ada</button>';
  }
  drawScore();
  document.getElementById('qNext').style.display=ok?'inline-block':'none';
}
function steal(i){
  if(i>=0)G[i].s+=5;
  document.getElementById('qSteal').innerHTML=i>=0?`<span class="ok">🎯 ${G[i].n} merebut +5 poin!</span>`:'';
  document.getElementById('qNext').style.display='inline-block';drawScore();
}
function nextQ(){
  qi++;gi=(gi+1)%G.length;
  if(qi>=QS.length){endQuiz();return}
  loadQ();
}
function endQuiz(){
  clearInterval(timer);
  document.getElementById('qGame').style.display='none';
  const r=G.slice().sort((a,b)=>b.s-a.s);
  const e=document.getElementById('qEnd');e.style.display='block';
  const podiumOrder=[r[1],r[0],r[2]];const heights=[170,230,130];const medals=["🥈","🥇","🥉"];
  e.innerHTML=`<h2>🎉 Kuis Selesai!</h2><div class="big">Juara: ${r[0].n}</div>
  <div class="pod">${podiumOrder.map((g,i)=>`<div style="background:${g.c};height:${heights[i]}px">${medals[i]}<br>${g.n}<br>${g.s}</div>`).join('')}</div>
  <p>${r.map((g,i)=>`${i+1}. ${g.n}: <b>${g.s}</b>`).join(' &nbsp;·&nbsp; ')}</p>
  <button class="btn" onclick="document.getElementById('qEnd').style.display='none';document.getElementById('qSetup').style.display='block'">🔁 Main lagi</button>`;
}
</script>
</body>
</html>
