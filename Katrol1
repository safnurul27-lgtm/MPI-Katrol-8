    s+=`<path d="M172 ${lt} V70 A28 28 0 0 1 228 70 V${hy}" ${rope}/>`+wheel(200,70,28)+box(144,lt,56,50,label)+hand(228,hy+10,false);
  }else if(type==='bergerak'){
    const py=220-d/2,hy=100-d;
    s+=`<path d="M176 10 V${py} A24 24 0 0 0 224 ${py} V${hy}" ${rope}/>`+wheel(200,py,24)+`<line x1="200" y1="${py}" x2="200" y2="${py+30}" stroke="#475569" stroke-width="5"/>`+box(168,py+30,64,50,label)+hand(224,hy-14,true);
  }else{
    const py=230-d/2,hy=150+d;
    s+=`<line x1="240" y1="10" x2="240" y2="60" stroke="#475569" stroke-width="5"/>`;
    s+=`<path d="M180 10 V${py} A20 20 0 0 0 220 ${py} V60 A20 20 0 0 1 260 60 V${hy}" ${rope}/>`+wheel(240,60,20)+wheel(200,py,20)+`<line x1="200" y1="${py}" x2="200" y2="${py+30}" stroke="#475569" stroke-width="5"/>`+box(168,py+30,64,50,label)+hand(260,hy+10,false);
  }
  if(lab)s+=annot(type,d);
  return s+'</svg>';
}
/* anotasi bagian-bagian katrol sebagai tuas */
function annot(type,d){
  d=Math.max(0,Math.min(60,d));
  const CT='#7c3aed',CB='#2563eb',CK='#dc2626',CS='#0d9488';
  const tx=(x,y,t,c,sz,a)=>`<text x="${x}" y="${y}" text-anchor="${a||'middle'}" font-size="${sz||14}" font-weight="800" fill="${c}" style="paint-order:stroke;stroke:#fff;stroke-width:4px">${t}</text>`;
  const dot=(x,y,c)=>`<circle cx="${x}" cy="${y}" r="5.5" fill="${c}" stroke="#fff" stroke-width="2"/>`;
  const dim=(x1,x2,y,c,t,up)=>`<path d="M${x1} ${y-5}V${y+5}M${x2} ${y-5}V${y+5}M${x1} ${y}H${x2}" stroke="${c}" stroke-width="3" fill="none"/>`+tx((x1+x2)/2,up?y-9:y+19,t,c,13);
  const vd=(x,y0,y1,t)=>d>0?`<path d="M${x-7} ${y0}H${x+7}M${x-7} ${y1}H${x+7}M${x} ${y0}V${y1}" stroke="${CS}" stroke-width="3" fill="none"/>`+tx(x+(x>200?12:-12),(y0+y1)/2+5,t,CS,14,x>200?'start':'end'):'';
  const n=type==='tetap'?1:2;
  const hs='h = '+(Math.round(d/n*10)/10).toString().replace('.',',')+' cm',ss='s = '+d+' cm';
  let o='';
  if(type==='tetap'){
    o+=dim(172,200,112,CB,'Lb')+dim(200,228,112,CK,'Lk');
    o+=dot(172,70,CB)+dot(200,70,CT)+dot(228,70,CK);
    o+=tx(160,60,'B',CB)+tx(240,60,'K',CK)+tx(214,34,'T',CT);
    o+=tx(236,128,'tali','#92400e',12,'start');
    o+=vd(312,140,140+d,ss)+vd(118,210,210-d,hs);
  }else if(type==='bergerak'){
    const py=220-d/2;
    o+=dim(176,200,py-34,CB,'Lb',true)+dim(176,224,py-56,CK,'Lk',true);
    o+=dot(176,py,CT)+dot(200,py,CB)+dot(224,py,CK);
    o+=tx(164,py+22,'T',CT)+tx(214,py+24,'B',CB)+tx(236,py+22,'K',CK);
    o+=tx(232,((100-d)+py)/2+4,'tali','#92400e',12,'start');
    o+=vd(330,100,100-d,ss)+vd(130,250,py+30,hs);
  }else{
    const py=230-d/2;
    o+=dim(180,200,py-34,CB,'Lb',true)+dim(180,220,py-56,CK,'Lk',true);
    o+=dot(180,py,CT)+dot(200,py,CB)+dot(220,py,CK);
    o+=tx(168,py+22,'T',CT)+tx(210,py+24,'B',CB)+tx(232,py+22,'K',CK);
    o+=tx(268,115,'tali','#92400e',12,'start')+tx(270,36,'katrol tetap','#475569',12,'start')+tx(164,py+46,'katrol bergerak','#475569',12,'end');
    o+=vd(330,150,150+d,ss)+vd(130,260,py+30,hs);
  }
  return o;
}
