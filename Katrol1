function wheel(cx,cy,r){return `<circle cx="${cx}" cy="${cy}" r="${r}" fill="#e0ecff" stroke="#1e3a8a" stroke-width="4"/><circle cx="${cx}" cy="${cy}" r="4" fill="#1e3a8a"/>`}
