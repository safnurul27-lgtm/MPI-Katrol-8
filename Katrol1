function hand(x,y,up){return `<text x="${x}" y="${y+8}" text-anchor="middle" font-size="30">✋</text><text x="${x+30}" y="${y+8}" font-size="22" fill="#dc2626" font-weight="700">${up?'↑':'↓'} F</text>`}
function drawPulley(type,d,label,lab){
  d=Math.max(0,Math.min(60,d));
  let s='<svg viewBox="0 0 400 340" width="100%" style="max-width:430px"><line x1="30" y1="10" x2="370" y2="10" stroke="#475569" stroke-width="8"/>';
  const rope='stroke="#92400e" stroke-width="3.5" fill="none"';
