.pod{display:flex;align-items:flex-end;justify-content:center;gap:.5rem;height:240px;margin:1rem 0}
.pod div{width:130px;border-radius:12px 12px 0 0;color:#fff;text-align:center;font-weight:800;padding-top:.3rem}
@media (max-width:700px){html{font-size:16px}.score{grid-template-columns:repeat(3,1fr)}}
