.btn:disabled{opacity:.45;cursor:not-allowed}
.pill{display:inline-block;padding:.15rem .6rem;border-radius:999px;font-size:.7rem;font-weight:700;color:#fff;background:var(--purple)}
.formula{background:#eef4ff;border-left:6px solid var(--blue);padding:.6rem 1rem;border-radius:8px;font-size:1.05rem;margin:.5rem 0}
.think{background:#fff7ed;border-left:6px solid var(--orange);padding:.6rem 1rem;border-radius:8px;margin:.6rem 0}
.ok{background:#ecfdf5;border-left:6px solid var(--green);padding:.6rem 1rem;border-radius:8px;margin:.6rem 0}
ul{margin:.3rem 0 .3rem 1.2rem;padding:0}
li{margin:.15rem 0}
.sub{display:flex;gap:.4rem;flex-wrap:wrap;margin-bottom:.8rem}
.sub button{border:2px solid var(--blue);background:#fff;color:var(--blue);padding:.4rem .9rem;border-radius:999px;font-weight:700;font-size:.85rem;cursor:pointer}
.sub button.active{background:var(--blue);color:#fff}
.sp{display:none}.sp.active{display:block}
.vid{position:relative;width:100%;aspect-ratio:16/9;border-radius:12px;overflow:hidden;background:#000}
.vid.short{aspect-ratio:9/16;max-height:62vh;width:auto;margin:0 auto}
.vid iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
.opt{display:block;width:100%;text-align:left;background:#fff;border:2px solid var(--line);border-radius:12px;padding:.7rem 1rem;margin:.4rem 0;font-size:.95rem;cursor:pointer}
.opt:hover:not(:disabled){border-color:var(--blue);background:#f1f6ff}
.opt.right{background:#dcfce7;border-color:var(--green)}
.opt.wrong{background:#fee2e2;border-color:var(--red)}
.bar{height:12px;background:#e5eaf2;border-radius:99px;overflow:hidden;margin:.4rem 0}
.bar>div{height:100%;background:var(--teal);width:0;transition:width .3s}
table{border-collapse:collapse;width:100%;font-size:.85rem}
th,td{border:1px solid var(--line);padding:.45rem .6rem;text-align:left;vertical-align:top}
th{background:#eaf0fa}
.ro{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:.5rem;margin-top:.5rem}
.ro div{background:#f1f5fb;border-radius:10px;padding:.5rem .7rem;font-size:.85rem}
.ro b{display:block;font-size:1.2rem;color:var(--blue)}
input[type=number],input[type=text],select{font-size:.95rem;padding:.4rem .6rem;border:2px solid var(--line);border-radius:10px;max-width:100%}
input[type=range]{width:100%;height:2rem}
